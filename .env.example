# Optional: GitHub personal access token.
# Raises the GitHub API limit from 60 to 5000 requests/hour.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Verbose debug logging (true/false)
DEBUG=false

# CORS allowed origins, comma-separated, or * for all
ALLOWED_ORIGINS=*

# Max files analyzed per repository (deep scan uses MAX_FILES_DEEP)
MAX_FILES=120
MAX_FILES_DEEP=300

# Analysis mode: "async" (default) returns 202 + job id and works in the
# background — for Docker/Render/VPS. "sync" runs the analysis inside the
# request and returns the full report — required on serverless hosts
# (Vercel) where background tasks do not survive the response.
ANALYZE_MODE=async

# Google OAuth sign-in (create at https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <your-origin>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string used to sign session cookies.
SESSION_SECRET=
# Server-side pepper mixed into password hashes (in addition to per-user salt).
PASSWORD_PEPPER=
# Vercel Blob read/write token (auto-created when a Blob store is connected).
BLOB_READ_WRITE_TOKEN=
